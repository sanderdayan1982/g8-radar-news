    ${clause}
    ORDER BY q.id ASC
    LIMIT ?`).all(nowIso, ...ids, limit).map((row) => ({
    ...row,
    payload: parseJson(row.payload_json, {}),
    subscription: parseJson(row.device_subscription_json, null),
