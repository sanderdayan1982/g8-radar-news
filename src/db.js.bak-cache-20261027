  } else if (tag && deviceId) {
    row = db.prepare('SELECT id, device_id FROM push_queue WHERE notification_tag=? AND device_id=? ORDER BY id DESC LIMIT 1').get(tag, deviceId);

  }
  if (!row) return false;
